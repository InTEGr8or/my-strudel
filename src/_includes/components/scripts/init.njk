<script>
// probe each soundfont on load so a single 404 does not mark the others dead
Object.keys(SF_FONTS).forEach(function (id) {
    loadFontData(SF_FONTS[id]).then(function () {
        sfStatus(id, true);
    }).catch(function () {
        sfStatus(id, false);
    });
});

document.querySelectorAll('.synth-voice').forEach(el => el.classList.toggle('active', el.dataset.voice === selectedVoice));

const tintSlider = document.getElementById('piano-tint-slider');
const tintValue = document.getElementById('piano-tint-value');
tintSlider.addEventListener('input', () => {
    setPianoTint(parseInt(tintSlider.value));
    tintValue.textContent = tintSlider.value + '%';
});
const savedTint = localStorage.getItem('piano-tint-opacity');
if (savedTint !== null) {
    tintSlider.value = savedTint;
    tintValue.textContent = savedTint + '%';
    setPianoTint(parseInt(savedTint));
}
const guideCheckbox = document.getElementById('color-guide-toggle');
if (localStorage.getItem('show-color-guide') === 'false') {
    guideCheckbox.checked = false;
    document.body.dataset.showColors = 'false';
}
if (localStorage.getItem('show-bar-numbers') === 'false') {
    applyBarNumbers(false);
} else {
    applyBarNumbers(true);
}
const savedTab = localStorage.getItem('selected-tab');
if (savedTab && document.querySelector(`.tab[data-tab="${savedTab}"]`)) {
    activateTab(savedTab);
} else {
    activateTab('sounds');
}
</script>
