<script>
const activeMidi = new Map();

function staffNote(noteName, on) {
    document.querySelectorAll('note-chart').forEach((chart) => {
        if (chart && chart.highlightStaffNote) {
            chart.highlightStaffNote(noteName, on);
        }
    });
}

window.__midiObservers = [];

window.handleMidiMessage = function handleMidiMessage(event) {
    const [status, midiNote, velocity] = event.data;
    const isNoteOn = (status & 0xf0) === 0x90 && velocity > 0;
    const isNoteOff = (status & 0xf0) === 0x80 || ((status & 0xf0) === 0x90 && velocity === 0);

    if (isNoteOn) {
        const noteName = midiToNoteName(midiNote);
        if (noteName) {
            activeMidi.set(midiNote, noteName);
            keyOn(noteName);
            staffNote(noteName, true);
            try { playMidiNote(midiNote, velocity); } catch (_) {}
        }
        if (window.KeyboardRange && KeyboardRange.isCalibrating()) {
            KeyboardRange.hear(midiNote);
            return;
        }
    } else if (isNoteOff) {
        const noteName = activeMidi.get(midiNote);
        if (noteName) {
            activeMidi.delete(midiNote);
            keyOff(noteName);
            staffNote(noteName, false);
        }
        if (window.KeyboardRange && KeyboardRange.isCalibrating()) return;
    }
    __midiObservers.forEach(fn => fn(midiNote, isNoteOn, isNoteOff));
}

if (navigator.requestMIDIAccess) {
    navigator.requestMIDIAccess().then(access => {
        const updateMidi = () => {
            const inputs = Array.from(access.inputs.values());
            const status = document.getElementById('midi-status');
            if (inputs.length > 0) {
                if (status) status.textContent = inputs[0].name;
                if (window.KeyboardRange && KeyboardRange.suggestFromMidiName) {
                    KeyboardRange.suggestFromMidiName(inputs[0].name);
                }
                inputs.forEach(input => {
                    input.onmidimessage = handleMidiMessage;
                });
            } else if (status) {
                status.textContent = 'No MIDI';
            }
        }
        updateMidi();
        access.onstatechange = updateMidi;
    });
}
</script>
