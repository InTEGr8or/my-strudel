<script>
const sidebar = document.getElementById('sidebar');
const toggleBtn = document.getElementById('sidebar-toggle');
toggleBtn.onclick = () => {
    sidebar.classList.toggle('collapsed');
};

window.previewSound = (sound) => {
    const previewRepl = document.getElementById('preview-repl');
    if (previewRepl && previewRepl.editor) {
        previewRepl.editor.evaluate(`s("${sound}").once()`);
    }
};

function activateTab(id) {
    document.querySelectorAll('.tab, .tab-content').forEach(t => t.classList.remove('active'));
    document.querySelector(`.tab[data-tab="${id}"]`)?.classList.add('active');
    document.getElementById(id)?.classList.add('active');
    localStorage.setItem('selected-tab', id);
}
window.showTab = (id) => activateTab(id);

window.toggleColorGuide = (show) => {
    document.body.dataset.showColors = show ? 'true' : 'false';
    const chart = document.querySelector('note-chart');
    if (chart && chart.setShowColors) chart.setShowColors(show);
};

function setPianoTint(val) {
    const root = document.documentElement;
    root.style.setProperty('--piano-tint-opacity', val / 100);
    localStorage.setItem('piano-tint-opacity', val);
}
</script>
