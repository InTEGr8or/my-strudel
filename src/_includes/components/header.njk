<header>
    <div class="controls">
        <a href="/">← Home</a>
        {% if showStrudel %}<button id="play-btn" class="primary">▶ PLAY</button>
        <button id="stop-btn" style="background: #dc3545; color: white; border-color: #bd2130;">■ STOP</button>{% endif %}
    </div>
    <h1 style="font-size: 1.3rem; margin: 0; color: var(--highlight); text-transform: uppercase;">{{ title }}</h1>
    <div class="controls">
        <button type="button" id="calibrate-btn" class="midi-calibrate" aria-expanded="false" aria-controls="calibrate-row" title="MIDI keyboard range. Click to measure the lowest and highest keys.">
            <span id="midi-status" class="midi-calibrate-midi">MIDI</span>
            <span id="keyboard-span" class="midi-calibrate-span">F2–C5</span>
        </button>
        <button id="sidebar-toggle" title="Toggle Sidebar" aria-expanded="false" aria-controls="sidebar">☰</button>
    </div>
</header>
