<header>
    <div class="controls">
        <a href="/">← Home</a>
        {% if showStrudel %}<button id="play-btn" class="primary">▶ PLAY</button>
        <button id="stop-btn" style="background: #dc3545; color: white; border-color: #bd2130;">■ STOP</button>{% endif %}
    </div>
    <h1 style="font-size: 1.3rem; margin: 0; color: var(--highlight); text-transform: uppercase;">{{ title }}</h1>
    <div class="controls">
        <div id="midi-status" style="font-size: 0.8rem; color: #888; margin-right: 0.4rem;">MIDI: checking...</div>
        <button type="button" id="calibrate-btn" class="calibrate-btn" aria-expanded="false" aria-controls="calibrate-row" title="Measure the lowest and highest keys on your keyboard">Calibrate</button>
        <button id="sidebar-toggle" title="Toggle Sidebar">☰</button>
    </div>
</header>
