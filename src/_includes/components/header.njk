<header>
    <div class="controls">
        <a href="{{ '/' | htmlBaseUrl }}">← Home</a>
        {% if type !== 'trainer' and type !== 'lesson' %}<button id="play-btn" class="primary">▶ PLAY</button>
        <button id="stop-btn" style="background: #dc3545; color: white; border-color: #bd2130;">■ STOP</button>{% endif %}
    </div>
    <h1 style="font-size: 1.3rem; margin: 0; color: var(--highlight); text-transform: uppercase;">{{ title }}</h1>
    <div class="controls">
        <div id="midi-status" style="font-size: 0.8rem; color: #888; margin-right: 1rem;">MIDI: checking...</div>
        <button id="sidebar-toggle" title="Toggle Sidebar">☰</button>
    </div>
</header>
