<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - Strudel Kids Lab</title>
    <script>window.process = { env: { NODE_ENV: 'production' } };</script>
    <script src="https://unpkg.com/@strudel/repl"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/abcjs/6.4.1/abcjs-basic-min.js"></script>
    <link rel="stylesheet" href="/css/note-chart.css">
    <style>
        :root {
            --bg: #fdfdfd;
            --text: #222;
            --header-bg: #eee;
            --panel-bg: #fff;
            --border: #ccc;
            --accent: #005cc5;
            --highlight: #ffcc00;
            --piano-bg: #333;
            --abc-bg: #fff;
            --abc-text: #000;
            --code-bg: #f0f0f0;
            --sidebar-bg: #f8f8f8;

            --ui-scale: 1.25;

            --note-alpha: 0.2;
            --note-d-alpha: 0.4;
            --octave-0: 173, 216, 230;
            --octave-1: 255, 160, 122;
            --octave-2: 144, 238, 144;
            --octave-3: 255, 182, 193;
            --octave-4: 255, 255, 153;
            --octave-5: 200, 180, 255;
            --octave-6: 255, 200, 150;
            --octave-7: 180, 230, 255;
            --octave-8: 200, 255, 200;
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #1a1a1a;
                --text: #eee;
                --header-bg: #222;
                --panel-bg: #1e1e1e;
                --border: #333;
                --accent: #58a6ff;
                --highlight: #ffcc00;
                --piano-bg: #000;
                --abc-bg: #111;
                --abc-text: #eee;
                --code-bg: #111;
                --sidebar-bg: #111;
            }
        }

        body {
            font-family: "Comic Sans MS", "Comic Sans", "Chalkboard SE", "Comic Neue", sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            display: flex; flex-direction: column; height: 100vh; overflow: hidden;
        }
        header {
            padding: 0.5rem 1rem; background: var(--header-bg); border-bottom: 3px solid var(--accent);
            display: flex; justify-content: space-between; align-items: center; height: 60px;
            box-sizing: border-box; flex-shrink: 0;
        }
        .controls { display: flex; gap: 0.5rem; align-items: center; }
        button {
            background: var(--header-bg); color: var(--text); border: 2px solid var(--border);
            padding: 0.4rem 1rem; border-radius: 12px; cursor: pointer; 
            font-family: inherit; font-weight: bold; font-size: 1rem;
        }
        button:hover { border-color: var(--accent); }
        button.primary { background: #28a745; color: white; border-color: #1e7e34; }
        
        .app-container { display: flex; flex: 1; overflow: hidden; position: relative; }
        main { flex: 1; display: flex; flex-direction: column; padding: 0; overflow-y: auto; position: relative; }
        
        .doc-container { background: var(--panel-bg); padding: 1.5rem; border-bottom: 2px solid var(--border); line-height: 1.6; flex-shrink: 0; }
        .doc-container h1, .doc-container h2 { margin-top: 0; color: var(--highlight); }
        #trainer-content { flex-shrink: 0; }
        
        /* Music Notation Styling */
        .abc-notation { 
            background: var(--abc-bg); 
            border: 3px solid var(--highlight); 
            border-radius: 15px; 
            margin: 1rem 0; 
            padding: 1.5rem;
            max-width: 100%;
            overflow-x: auto;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        /* Conditional Inversion for Dark Mode SVG */
        @media (prefers-color-scheme: dark) {
            .abc-notation svg path, 
            .abc-notation svg text, 
            .abc-notation svg tspan,
            .abc-notation svg rect { fill: var(--abc-text) !important; stroke: var(--abc-text) !important; }
            .abc-notation svg line { stroke: var(--abc-text) !important; }
        }
        .abc-notation svg { display: block; margin: 0 auto; max-width: 100%; }
        
        .editor-container { flex-shrink: 0; display: flex; flex-direction: column; min-height: 400px; background: var(--code-bg); }
        .editor-container div.cm-editor { flex: 1; height: 100% !important; font-size: 18px; }

        #piano-container {
            flex-shrink: 0; background: var(--piano-bg); display: flex; 
            justify-content: flex-start; align-items: flex-start; padding: calc(25px * var(--ui-scale)) calc(10px * var(--ui-scale));
            border-top: 3px solid var(--border);
            overflow-x: auto;
        }
        .piano-key { 
            border: 1px solid #444; background: white; height: calc(110px * var(--ui-scale)); width: calc(35px * var(--ui-scale)); 
            margin: 1px; border-radius: 0 0 8px 8px; box-sizing: border-box;
            align-self: flex-end;
        }
        .piano-key.black { 
            background: #111; height: calc(65px * var(--ui-scale)); width: calc(22px * var(--ui-scale)); 
            margin-left: calc(-12px * var(--ui-scale)); margin-right: calc(-12px * var(--ui-scale)); z-index: 2; 
            border-color: #000; align-self: flex-start;
        }
        .piano-key.active { background: #58a6ff !important; box-shadow: 0 0 20px #58a6ff; z-index: 3; }
        .piano-key.dimmed { opacity: 0.35; }
        .piano-key.dimmed.active { opacity: 1; }
        
        strudel-editor { display: block; height: 0; }
        a { color: var(--accent); text-decoration: none; }

        aside { 
            width: 250px; display: flex; flex-direction: column; background: var(--sidebar-bg); 
            flex-shrink: 0; border-left: 2px solid var(--border);
            transition: transform 0.3s ease, margin-right 0.3s ease;
        }
        aside.collapsed { margin-right: -250px; transform: translateX(100%); }
        .tabs { display: flex; background: var(--header-bg); border-bottom: 2px solid var(--border); }
        .tab { padding: 0.75rem 1rem; cursor: pointer; font-size: 1rem; border-bottom: 3px solid transparent; font-family: inherit; }
        .tab.active { border-bottom-color: var(--accent); background: var(--bg); color: var(--accent); }
        .tab-content { flex: 1; overflow-y: auto; padding: 1.5rem; display: none; }
        .tab-content.active { display: block; }
        
        #sounds code, #synth code {
            cursor: pointer; background: var(--header-bg); padding: 6px 10px; border-radius: 10px; 
            margin: 5px; display: inline-block; font-family: monospace; font-size: 1rem;
            color: var(--highlight); border: 1px solid var(--border);
        }
        #sounds code:hover, #synth code:hover { border-color: var(--highlight); }
        #synth code.active { border-color: var(--accent); background: var(--accent); color: white; }

        @media (max-width: 768px) {
            body { height: auto; overflow: auto; }
            header { position: sticky; top: 0; z-index: 100; }
            .app-container { flex-direction: column; overflow: visible; }
            main { overflow: visible; }
            .editor-container { min-height: 500px; }
            aside { width: 100%; border-left: none; }
            aside.collapsed { margin-right: 0; transform: none; display: none; }
        }
    </style>
</head>
<body>
    <header>
        <div class="controls">
            <a href="{{ '/' | htmlBaseUrl }}">← Home</a>
            {% if type !== 'trainer' %}<button id="play-btn" class="primary">▶ PLAY</button>
            <button id="stop-btn" style="background: #dc3545; color: white; border-color: #bd2130;">■ STOP</button>{% endif %}
        </div>
        <h1 style="font-size: 1.3rem; margin: 0; color: var(--highlight); text-transform: uppercase;">{{ title }}</h1>
        <div class="controls">
            <div id="midi-status" style="font-size: 0.8rem; color: #888; margin-right: 1rem;">MIDI: checking...</div>
            <button id="sidebar-toggle" title="Toggle Sidebar">☰</button>
        </div>
    </header>
    
    <div class="app-container">
        <main>
            {% if content %}
            {% if type !== 'trainer' %}
            <div class="doc-container">{{ content | safe }}</div>
            {% else %}
            <div id="trainer-content">{{ content | safe }}</div>
            {% endif %}
            {% endif %}

            {% if type !== 'trainer' %}
            <template id="song-source">{{ strudelCode | safe }}</template>
            <div class="editor-container">
                <strudel-editor id="strudel-repl"></strudel-editor>
            </div>
            {% endif %}

            <div id="note-chart-container"><note-chart></note-chart></div>
            <div id="midi-notes" style="padding: 0.5rem 1rem; font-size: 1.5rem; font-weight: bold; color: var(--accent); text-align: center; min-height: 1.8rem; letter-spacing: 0.3em; font-family: monospace;"></div>
            <div id="piano-container"></div>
        </main>
        
        <aside id="sidebar">
            <div class="tabs">
                <div class="tab active" onclick="showTab('sounds')">Sounds</div>
                <div class="tab" onclick="showTab('synth')">Synth</div>
                <div class="tab" onclick="showTab('ref')">Ref</div>
            </div>
            <div id="sounds" class="tab-content active">
                <p style="font-size: 1rem; color: #888; margin-top: 0;">Tap to hear!</p>
                <code onclick="previewSound('bd')">bd</code>
                <code onclick="previewSound('sd')">sd</code>
                <code onclick="previewSound('hh')">hh</code>
                <code onclick="previewSound('cp')">cp</code>
                <code onclick="previewSound('bass')">bass</code>
            </div>
            <div id="synth" class="tab-content">
                <p style="font-size: 1rem; color: #888; margin-top: 0;">MIDI voice:</p>
                <code class="synth-voice active" data-voice="grand-piano" onclick="selectVoice('grand-piano')">Grand Piano</code>
                <code class="synth-voice" data-voice="triangle" onclick="selectVoice('triangle')">Triangle</code>
                <code class="synth-voice" data-voice="sine" onclick="selectVoice('sine')">Sine</code>
                <code class="synth-voice" data-voice="sawtooth" onclick="selectVoice('sawtooth')">Sawtooth</code>
                <code class="synth-voice" data-voice="square" onclick="selectVoice('square')">Square</code>
            </div>
            <div id="ref" class="tab-content">
                <code>s()</code>, <code>n()</code>, <code>gain()</code>
            </div>
        </aside>
    </div>
    
    <strudel-editor id="preview-repl" style="position: absolute; visibility: hidden; width: 0; height: 0;"></strudel-editor>

    <script type="application/json" id="device-config">
    {
        "id": "donner-n-32",
        "name": "Donner N-32",
        "range": { "low": 41, "high": 72 },
        "noteCount": 32,
        "description": "32-key mini keyboard, F2-C5"
    }
    </script>

    <script>
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('sidebar-toggle');
        toggleBtn.onclick = () => {
            sidebar.classList.toggle('collapsed');
        };

        window.previewSound = (sound) => {
            const previewRepl = document.getElementById('preview-repl');
            if (previewRepl && previewRepl.editor) {
                previewRepl.editor.evaluate(`s("${sound}").once()`);
            }
        };

        const piano = document.getElementById('piano-container');
        const NOTES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
        const keys = {};
        const deviceCfg = JSON.parse(document.getElementById('device-config').textContent);

        for (let midi = 21; midi <= 108; midi++) {
            const oct = Math.floor(midi / 12) - 1;
            const noteName = NOTES[midi % 12];
            const isBlack = noteName.includes('#');
            const fullName = `${noteName.toLowerCase()}${oct}`.replace('#', 's');
            const key = document.createElement('div');
            key.className = `piano-key ${isBlack ? 'black' : 'white'}`;
            key.id = `key-${fullName}`;
            key.dataset.midi = midi;
            if (midi < deviceCfg.range.low || midi > deviceCfg.range.high) {
                key.classList.add('dimmed');
            }
            piano.appendChild(key);
            keys[fullName] = key;
        }

        const activeKeys = new Set();

        function flashKey(note) {
            const id = `key-${note.toLowerCase()}`;
            const el = document.getElementById(id);
            if (el) {
                el.classList.add('active');
                setTimeout(() => {
                    if (!activeKeys.has(note.toLowerCase())) {
                        el.classList.remove('active');
                    }
                }, 150);
            }
        }

        function keyOn(noteName) {
            const el = document.getElementById(`key-${noteName}`);
            if (el) el.classList.add('active');
        }

        function keyOff(noteName) {
            const el = document.getElementById(`key-${noteName}`);
            if (el) el.classList.remove('active');
        }

        const NOTE_LABELS = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];

        function midiToNoteName(midi) {
            const names = ['c', 'cs', 'd', 'ds', 'e', 'f', 'fs', 'g', 'gs', 'a', 'as', 'b'];
            const oct = Math.floor(midi / 12) - 1;
            return `${names[midi % 12]}${oct}`;
        }

        function midiNoteDisplay(midi) {
            const oct = Math.floor(midi / 12) - 1;
            return `${NOTE_LABELS[midi % 12]}${oct}`;
        }

        const activeMidi = new Map();

        function staffNote(noteName, on) {
            const chart = document.querySelector('note-chart');
            if (chart && chart.highlightStaffNote) {
                chart.highlightStaffNote(noteName, on);
            }
        }

        function midiToFreq(midi) {
            return 440 * Math.pow(2, (midi - 69) / 12);
        }

        const VOICES = {
            'grand-piano': { type: 'piano', label: 'Grand Piano' },
            'triangle': { type: 'triangle', label: 'Triangle' },
            'sine': { type: 'sine', label: 'Sine' },
            'sawtooth': { type: 'sawtooth', label: 'Sawtooth' },
            'square': { type: 'square', label: 'Square' },
        };
        let selectedVoice = 'grand-piano';
        window.selectVoice = (id) => {
            selectedVoice = id;
            document.querySelectorAll('.synth-voice').forEach(el => el.classList.toggle('active', el.dataset.voice === id));
        };

        let midiAudioCtx = null;

        function playMidiNote(midiNote, velocity) {
            if (!midiAudioCtx) {
                midiAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            const freq = midiToFreq(midiNote);
            const vol = (velocity / 127) * 0.3;
            const voice = VOICES[selectedVoice];

            if (voice.type === 'piano') {
                // three oscillators: fundamental + two detuned for that piano chorus
                [1, 1.003, 0.997].forEach((detune, i) => {
                    const osc = midiAudioCtx.createOscillator();
                    const g = midiAudioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.value = freq * detune;
                    g.gain.setValueAtTime(vol * (i === 0 ? 0.6 : 0.2), midiAudioCtx.currentTime);
                    g.gain.exponentialRampToValueAtTime(0.001, midiAudioCtx.currentTime + 1.5);
                    osc.connect(g);
                    g.connect(midiAudioCtx.destination);
                    osc.start();
                    osc.stop(midiAudioCtx.currentTime + 1.5);
                });
            } else {
                const osc = midiAudioCtx.createOscillator();
                const gain = midiAudioCtx.createGain();
                osc.type = voice.type;
                osc.frequency.value = freq;
                gain.gain.setValueAtTime(vol, midiAudioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, midiAudioCtx.currentTime + 0.8);
                osc.connect(gain);
                gain.connect(midiAudioCtx.destination);
                osc.start();
                osc.stop(midiAudioCtx.currentTime + 0.8);
            }
        }

        function updateMidiNotes() {
            const el = document.getElementById('midi-notes');
            if (activeMidi.size === 0) {
                el.textContent = '';
                return;
            }
            const sorted = Array.from(activeMidi.keys()).sort((a, b) => a - b);
            const notes = sorted.map(midiNoteDisplay);
            el.textContent = notes.join('  ');
        }

        window.__midiObservers = [];

        function handleMidiMessage(event) {
            const [status, midiNote, velocity] = event.data;
            const isNoteOn = (status & 0xf0) === 0x90 && velocity > 0;
            const isNoteOff = (status & 0xf0) === 0x80 || ((status & 0xf0) === 0x90 && velocity === 0);

            if (isNoteOn) {
                const noteName = midiToNoteName(midiNote);
                if (noteName) {
                    activeMidi.set(midiNote, noteName);
                    keyOn(noteName);
                    staffNote(noteName, true);
                    playMidiNote(midiNote, velocity);
                    updateMidiNotes();
                }
            } else if (isNoteOff) {
                const noteName = activeMidi.get(midiNote);
                if (noteName) {
                    activeMidi.delete(midiNote);
                    keyOff(noteName);
                    staffNote(noteName, false);
                    updateMidiNotes();
                }
            }
            __midiObservers.forEach(fn => fn(midiNote, isNoteOn, isNoteOff));
        }

        {% if type !== 'trainer' %}
        const repl = document.getElementById('strudel-repl');
        const source = document.getElementById('song-source');
        
        const interval = setInterval(() => {
            if (repl.editor) {
                repl.editor.setCode(source.content.textContent.trim());
                
                const originalDraw = repl.editor.onDraw;
                repl.editor.onDraw = (haps, time, painters) => {
                    const currentFrame = haps.filter((hap) => hap.isActive(time));
                    currentFrame.forEach(hap => {
                        if (hap.value && hap.value.note) {
                            flashKey(hap.value.note);
                        }
                    });
                    if (originalDraw) originalDraw(haps, time, painters);
                };

                clearInterval(interval);
            }
        }, 50);

        document.getElementById('play-btn').onclick = () => repl.editor?.evaluate();
        document.getElementById('stop-btn').onclick = () => {
            repl.editor?.stop();
            document.getElementById('preview-repl').editor?.stop();
        };
        {% endif %}

        window.addEventListener('load', () => {
            document.querySelectorAll('code.language-abc').forEach((el) => {
                const pre = el.parentNode;
                const target = document.createElement('div');
                target.className = 'abc-notation';
                pre.parentNode.replaceChild(target, pre);
                ABCJS.renderAbc(target, el.textContent.trim(), { responsive: 'resize' });
            });
        });

        if (navigator.requestMIDIAccess) {
            navigator.requestMIDIAccess().then(access => {
                const updateMidi = () => {
                    const inputs = Array.from(access.inputs.values());
                    const status = document.getElementById('midi-status');
                    if (inputs.length > 0) {
                        status.textContent = `MIDI: ${inputs[0].name}`;
                        inputs.forEach(input => {
                            input.onmidimessage = handleMidiMessage;
                        });
                    } else {
                        status.textContent = "MIDI: Disconnected";
                    }
                }
                updateMidi();
                access.onstatechange = updateMidi;
            });
        }

        window.showTab = (id) => {
            document.querySelectorAll('.tab, .tab-content').forEach(t => t.classList.remove('active'));
            if (event && event.target) {
                event.target.classList.add('active');
            }
            document.getElementById(id).classList.add('active');
        }
    </script>
    <script type="module" src="/js/note-chart.js"></script>
</body>
</html>
