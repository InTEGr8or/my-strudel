<!DOCTYPE html>
<html lang="en">
{%- set showStrudel = strudelCode and type != 'trainer' and type != 'lesson' -%}
{%- set showStaff = type == 'trainer' or type == 'lesson' or type == 'abc' or abcSource -%}
{%- set loadAbcjs = type != 'trainer' and type != 'abc' -%}
<head>
    {% include 'components/head.njk' %}
</head>
<body{% if type %} data-type="{{ type }}"{% endif %}>
    {% include 'components/header.njk' %}

    <div class="app-container">
        <main>
            {% if content %}
            {% if type !== 'trainer' and type !== 'lesson' %}
            <div class="doc-container">{{ content | safe }}</div>
            {% else %}
            <div id="trainer-content">{{ content | safe }}</div>
            {% endif %}
            {% endif %}

            {% if abcSong and type != 'lesson' %}
            {% include 'components/abc-trainer.njk' %}
            {% endif %}

            {% if showStrudel %}
            {% include 'components/strudel.njk' %}
            {% endif %}

            {% if showStaff %}
            {% include 'components/staff.njk' %}
            {% endif %}
            {% include 'components/piano.njk' %}
        </main>

        {% include 'components/sidebar.njk' %}
    </div>

    {% if showStrudel %}
    <strudel-editor id="preview-repl" style="position: absolute; visibility: hidden; width: 0; height: 0;"></strudel-editor>
    {% endif %}

    {% include 'components/device-config.njk' %}
    {% include 'components/scripts/piano.njk' %}
    {% include 'components/scripts/ui.njk' %}
    {% include 'components/scripts/synth.njk' %}
    {% include 'components/scripts/midi.njk' %}
    {% include 'components/scripts/audio-init.njk' %}
    {% include 'components/scripts/abc-render.njk' %}
    {% include 'components/scripts/strudel-repl.njk' %}
    {% include 'components/scripts/init.njk' %}

    <script type="module" src="/js/note-chart.js"></script>
    <script src="/js/trainer-utils.js"></script>
    <script src="/js/step-trainer.js"></script>
    <script src="/js/tape-trainer.js"></script>
    <script src="/js/trainer.js"></script>
</body>
</html>
